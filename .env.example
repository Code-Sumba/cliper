# Copy to .env for local runs. In GitHub, these go in
# Settings -> Secrets and variables -> Actions.
# Everything is optional: whatever is missing simply stays switched off, and
# `python -m cliper.doctor` tells you exactly what that costs you.

# =====================================================================
# STREAM SOURCES  (where clips come from)
# =====================================================================
# Twitch: dev.twitch.tv/console/apps -> register an app. Takes two minutes.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube: console.cloud.google.com -> enable "YouTube Data API v3".
# Only needed for live detection. Chat replay works without a key.
YOUTUBE_API_KEY=

# =====================================================================
# STORAGE  (Instagram and friends fetch a URL; they will not take an upload)
# =====================================================================
# none | s3   ("s3" covers Cloudflare R2, Backblaze B2, AWS S3, MinIO...)
CLIPER_STORAGE=none
S3_ENDPOINT_URL=          # R2: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=clips
S3_PUBLIC_BASE=           # R2: https://pub-<hash>.r2.dev, or your own domain

# =====================================================================
# PLATFORMS  (where clips go)
# =====================================================================
# Leave blank to use every platform whose credentials are filled in.
# Or name them: CLIPER_PLATFORMS=youtube,instagram
CLIPER_PLATFORMS=

# --- YouTube Shorts ---
# Run `python scripts/get_youtube_token.py` once, locally, for the refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private   # private | unlisted | public. Start private.
YOUTUBE_CATEGORY_ID=20    # 20 = Gaming

# --- Instagram Reels ---
# Needs a Business or Creator account linked to a Facebook Page.
# A personal account cannot use this API at all.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_SHARE_TO_FEED=true
IG_PROCESS_TIMEOUT=600

# --- TikTok ---
# developers.tiktok.com. Without app review you can only reach drafts,
# which is still useful: the clip lands in the app and you tap post.
TIKTOK_ACCESS_TOKEN=
TIKTOK_DIRECT_POST=false  # true needs an audited app
TIKTOK_PRIVACY=SELF_ONLY

# --- Kick ---
# No documented posting API. The class is wired and waiting; see
# cliper/platforms/kick.py. Kick works fine as a stream SOURCE.
KICK_ACCESS_TOKEN=

# --- Webhook: anything else (Make, n8n, Zapier, Discord, your own server) ---
WEBHOOK_URL=
WEBHOOK_SECRET=

# =====================================================================
# BEHAVIOUR
# =====================================================================
# false = clips land in a review queue and wait for you (default, recommended)
# true  = publish with no human check. Read the README section on this first.
AUTO_PUBLISH=false

# Measure stream loudness and use it to re-rank chat spikes. Costs an
# audio-only download per stream (~250 MB for 5 hours). Set false to skip.
CLIPER_VOLUME=true
